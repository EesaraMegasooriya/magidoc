# Copy to .env for `docker compose up`
MAGIDOC_JWT_SECRET=replace-with-output-of-openssl-rand-base64-48
DB_PASSWORD=change-me
MAGIDOC_CORS_ORIGINS=http://localhost:3000
# Block requests to private/internal IPs from the request runner (recommended for shared servers)
MAGIDOC_PROXY_BLOCK_PRIVATE=true
# Session cookie "Secure" flag. Must be true when served over HTTPS (production); false only for plain-http local use.
MAGIDOC_COOKIE_SECURE=false
