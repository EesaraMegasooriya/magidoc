# MagiDoc production settings — copy to .env on the server and fill in.
# Never commit .env (it's in .gitignore).

# Public address people open (must match your nginx server_name, https://).
MAGIDOC_PUBLIC_URL=https://magidoc.example.com

# Long random secrets. Generate with:
#   openssl rand -base64 48   (JWT secret)
#   openssl rand -hex 24      (database password)
MAGIDOC_JWT_SECRET=
DB_PASSWORD=

# Local port your host nginx proxies to (bound to 127.0.0.1 only).
MAGIDOC_HTTP_PORT=3000

# Keep true in production (requires HTTPS). false only for a plain-http test.
MAGIDOC_COOKIE_SECURE=true

# Blocks the request runner from calling private/internal addresses (recommended on a shared server).
MAGIDOC_PROXY_BLOCK_PRIVATE=true
